import pandas as pd

# 1) Load the raw LendingClub CSV

file_path = "/content/drive/MyDrive/accepted_2007_to_2018Q4.csv"  

df = pd.read_csv(file_path, low_memory=False)
print("Raw shape:", df.shape)


# 2) Keep only the core columns needed for portfolio analytics

keep_cols = [
    "issue_d", "loan_amnt", "term", "int_rate",
    "grade", "sub_grade", "purpose",
    "annual_inc", "dti", "emp_length",
    "home_ownership", "verification_status",
    "addr_state", "loan_status"
]

df = df[keep_cols].copy()
print("After selecting columns:", df.shape)


# 3) Basic cleaning


# Remove rows missing critical fields
df = df.dropna(subset=["issue_d", "loan_amnt", "loan_status"])

# Standardize strings
df["loan_status"] = df["loan_status"].astype(str).str.strip()
df["term"] = df["term"].astype(str).str.strip()
df["purpose"] = df["purpose"].astype(str).str.strip()

# Ensure numeric fields are numeric
df["loan_amnt"] = pd.to_numeric(df["loan_amnt"], errors="coerce")
df["int_rate"] = pd.to_numeric(df["int_rate"], errors="coerce")
df["annual_inc"] = pd.to_numeric(df["annual_inc"], errors="coerce")
df["dti"] = pd.to_numeric(df["dti"], errors="coerce")

df = df.dropna(subset=["loan_amnt"])

print("After cleaning:", df.shape)


# 4) Filter to the most useful loan_status categories

valid_status = [
    "Fully Paid", "Charged Off", "Default",
    "Current", "Late (16-30 days)", "Late (31-120 days)",
    "In Grace Period"
]

df = df[df["loan_status"].isin(valid_status)].copy()
print("After filtering loan_status:", df.shape)


# 5) Create issue_date and issue_year

df["issue_date"] = pd.to_datetime(df["issue_d"], format="%b-%Y", errors="coerce")
df = df.dropna(subset=["issue_date"])

df["issue_year"] = df["issue_date"].dt.year
df["issue_month"] = df["issue_date"].dt.to_period("M").astype(str)

print("After parsing issue_date:", df.shape)


# 6) Reduce size for BigQuery Sandbox upload

# Using a Sample of 300,000 rows only 
TARGET_ROWS = 300_000
if len(df) > TARGET_ROWS:
    df_small = df.sample(n=TARGET_ROWS, random_state=42)
else:
    df_small = df.copy()

print("Reduced dataset shape:", df_small.shape)


# 7) Export reduced CSV for BigQuery Sandbox

output_file = "lendingclub_sandbox.csv"
df_small.to_csv(output_file, index=False)

print("Saved:", output_file)
